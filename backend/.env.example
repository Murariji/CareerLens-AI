# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git, so your key never reaches GitHub.

# Optional. Without it, CareerLens still works and returns the baseline report.
# Create one at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
# CAREERLENS_LLM_MODEL=claude-sonnet-5-5

# Frontend addresses allowed to call this API (comma-separated, no trailing slash).
CAREERLENS_ALLOWED_ORIGINS=http://localhost:5173
